{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "noar-badge",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"assets": { "directory": "./public" },
	"routes": [{ "pattern": "status.hemk.dev", "custom_domain": true }],
	"ratelimits": [{ "name": "MEASURES", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
}
